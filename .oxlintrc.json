{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["dist", "src/routeTree.gen.ts", "docs"],
  "rules": {
    "react-hooks/exhaustive-deps": "warn"
  }
}
